*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#202123;
color:white;
}

.app{
display:flex;
height:100vh;
}

.sidebar{
width:260px;
background:#171717;
display:flex;
flex-direction:column;
border-right:1px solid #2f2f2f;
}

.logo{
padding:20px;
font-size:22px;
font-weight:bold;
}

.history{
flex:1;
padding:15px;
overflow:auto;
}

.chat-item{
padding:12px;
border-radius:10px;
cursor:pointer;
margin-bottom:10px;
}

.chat-item:hover{
background:#2d2d2d;
}
.main{
flex:1;
display:flex;
flex-direction:column;
}

.header{
height:70px;
display:flex;
justify-content:space-between;
align-items:center;
padding:20px;
border-bottom:1px solid #333;
}

.chat-area{
flex:1;
overflow:auto;
padding:25px;
}

.message{
display:flex;
margin-bottom:20px;
}

.message.user{
justify-content:flex-end;
}

.message.ai{
justify-content:flex-start;
}

.bubble{
padding:15px;
border-radius:15px;
max-width:700px;
line-height:1.7;
}

.user .bubble{
background:#10a37f;
}

.ai .bubble{
background:#343541;
}

.input-area{
display:flex;
padding:20px;
gap:10px;
border-top:1px solid #333;
}
button{

padding:14px 22px;

border:none;

border-radius:12px;

background:#10a37f;

color:white;

cursor:pointer;

transition:.3s;

}

button:hover{

background:#0d8d6d;

}

input{

flex:1;

padding:15px;

border:none;

outline:none;

border-radius:12px;

background:#40414f;

color:white;

font-size:15px;

}

.model-select{

padding:10px;

border:none;

border-radius:10px;

background:#40414f;

color:white;

}
@media(max-width:768px){

.sidebar{

display:none;

}

.logo{

font-size:18px;

}

.header h1{

font-size:18px;

}

}
const chat=document.getElementById("chat");

const input=document.getElementById("pesan");

const kirim=document.getElementById("kirim");

const model=document.getElementById("model");

kirim.onclick=kirimPesan;

input.addEventListener("keydown",(e)=>{

if(e.key==="Enter"){

kirimPesan();

}

});

function kirimPesan(){

let teks=input.value.trim();

if(teks==="") return;

chat.innerHTML+=`

<div class="message user">

<div class="bubble">

${teks}

</div>

</div>

`;

input.value="";

setTimeout(()=>{

chat.innerHTML+=`

<div class="message ai">

<div class="bubble">

Model :

<b>${model.value}</b>

<br><br>

Saya belum terhubung ke AI.

</div>

</div>

`;

chat.scrollTop=chat.scrollHeight;

},700);

    }
