/* ==========================
evermineAI V5 Flash Pro
Theme: Neon Purple
========================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Inter,Arial,sans-serif;
}

body{
background:#09090f;
color:#fff;
height:100vh;
overflow:hidden;
}

/* Background Glow */

body::before{
content:"";
position:fixed;
top:-250px;
left:-250px;
width:700px;
height:700px;
background:#7c3aed;
filter:blur(220px);
opacity:.35;
z-index:-2;
}

body::after{
content:"";
position:fixed;
bottom:-250px;
right:-250px;
width:700px;
height:700px;
background:#9333ea;
filter:blur(220px);
opacity:.25;
z-index:-2;
}

/* Layout */

.app{
display:flex;
height:100vh;
}

/* Sidebar */

.sidebar{
width:270px;
background:rgba(20,20,30,.85);
backdrop-filter:blur(20px);
border-right:1px solid rgba(255,255,255,.08);
display:flex;
flex-direction:column;
padding:20px;
}

.logo{
font-size:28px;
font-weight:bold;
color:#d8b4fe;
margin-bottom:20px;
text-shadow:0 0 15px #9333ea;
}

.new-chat{
padding:15px;
border:none;
border-radius:14px;
background:linear-gradient(90deg,#7c3aed,#9333ea);
color:white;
cursor:pointer;
font-size:16px;
font-weight:bold;
transition:.3s;
box-shadow:0 0 20px rgba(147,51,234,.4);
}

.new-chat:hover{
transform:scale(1.04);
box-shadow:0 0 35px #9333ea;
}

.history{
margin-top:25px;
flex:1;
overflow:auto;
}

.chat-item{
padding:15px;
margin-bottom:10px;
background:rgba(255,255,255,.03);
border-radius:12px;
cursor:pointer;
transition:.3s;
}

.chat-item:hover{
background:#9333ea;
}

/* Main */

.main{
flex:1;
display:flex;
flex-direction:column;
}

/* Header */

.header{
display:flex;
justify-content:space-between;
align-items:center;
padding:25px 35px;
background:rgba(20,20,30,.5);
backdrop-filter:blur(20px);
border-bottom:1px solid rgba(255,255,255,.08);
}

.header h1{
font-size:34px;
color:#f3e8ff;
}

.header p{
color:#a78bfa;
margin-top:5px;
}

.model-select{
background:#1d1b2b;
color:white;
border:1px solid #7c3aed;
padding:12px 20px;
border-radius:12px;
outline:none;
}

/* Chat */

.chat-area{
flex:1;
padding:35px;
overflow-y:auto;
}

.message{
display:flex;
margin-bottom:20px;
}

.message.user{
justify-content:flex-end;
}

.message.ai{
justify-content:flex-start;
}

.bubble{
padding:18px 22px;
max-width:700px;
border-radius:18px;
line-height:1.7;
animation:fade .3s;
}

.ai .bubble{
background:#191927;
border:1px solid #7c3aed;
box-shadow:0 0 18px rgba(147,51,234,.3);
}

.user .bubble{
background:linear-gradient(90deg,#7c3aed,#9333ea);
box-shadow:0 0 20px rgba(147,51,234,.5);
}

/* Input */

.input-area{
display:flex;
padding:20px;
gap:15px;
background:rgba(20,20,30,.7);
backdrop-filter:blur(20px);
}

.input-area input{
flex:1;
padding:16px;
border:none;
outline:none;
border-radius:15px;
background:#15151f;
color:white;
font-size:16px;
border:1px solid #7c3aed;
}

.input-area button{
padding:16px 30px;
border:none;
border-radius:15px;
background:linear-gradient(90deg,#7c3aed,#9333ea);
color:white;
cursor:pointer;
font-weight:bold;
box-shadow:0 0 20px rgba(147,51,234,.4);
transition:.3s;
}

.input-area button:hover{
transform:scale(1.05);
box-shadow:0 0 35px #9333ea;
}

@keyframes fade{
from{
opacity:0;
transform:translateY(20px);
}
to{
opacity:1;
transform:translateY(0);
}
}

/* Scroll */

::-webkit-scrollbar{
width:8px;
}

::-webkit-scrollbar-thumb{
background:#7c3aed;
border-radius:20px;
}

/* Responsive */

@media(max-width:900px){

.sidebar{
display:none;
}

.header{
padding:20px;
}

.header h1{
font-size:24px;
}

.chat-area{
padding:20px;
}

.input-area{
padding:15px;
}

}

@media(max-width:600px){

.header{
flex-direction:column;
gap:15px;
align-items:flex-start;
}

.model-select{
width:100%;
}

.input-area{
flex-direction:column;
}

.input-area button{
width:100%;
}

}
