*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#202123;
    color:white;
}

.app{
    display:flex;
    height:100vh;
}

.sidebar{
    width:260px;
    background:#171717;
    display:flex;
    flex-direction:column;
    border-right:1px solid #2d2d2d;
}

.logo{
    padding:20px;
    font-size:22px;
    font-weight:bold;
}

.new-chat{
    margin:15px;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#10a37f;
    color:white;
    cursor:pointer;
    font-size:15px;
    transition:.3s;
}

.new-chat:hover{
    background:#0d8f6f;
}

.history{
    flex:1;
    padding:15px;
    overflow-y:auto;
}

.chat-item{
    padding:12px;
    border-radius:10px;
    cursor:pointer;
    margin-bottom:10px;
}

.chat-item:hover{
    background:#2b2b2b;
}
.main{
    flex:1;
    display:flex;
    flex-direction:column;
    background:#202123;
}

.header{
    height:80px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 30px;
    border-bottom:1px solid #2d2d2d;
}

.title h1{
    font-size:24px;
}

.title p{
    color:#9ca3af;
}

.model-select{
    background:#343541;
    color:white;
    border:none;
    border-radius:10px;
    padding:12px;
}

.chat-area{
    flex:1;
    overflow-y:auto;
    padding:30px;
}

.message{
    display:flex;
    margin-bottom:20px;
}

.message.user{
    justify-content:flex-end;
}

.message.ai{
    justify-content:flex-start;
}

.bubble{
    max-width:700px;
    padding:18px;
    border-radius:16px;
    line-height:1.7;
}

.user .bubble{
    background:#10a37f;
}

.ai .bubble{
    background:#343541;
}
.input-area{
    display:flex;
    gap:10px;
    padding:20px;
    border-top:1px solid #2d2d2d;
}

#pesan{
    flex:1;
    padding:15px;
    border:none;
    border-radius:12px;
    outline:none;
    background:#343541;
    color:white;
}

#kirim{
    padding:15px 22px;
    border:none;
    border-radius:12px;
    background:#10a37f;
    color:white;
    cursor:pointer;
}

#kirim:hover{
    background:#0d8f6f;
}
@media(max-width:768px){

.app{
    flex-direction:column;
}

.sidebar{
    width:100%;
    height:200px;
}

.header{
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
}

.chat-area{
    padding:15px;
}

.input-area{
    padding:15px;
}

}
